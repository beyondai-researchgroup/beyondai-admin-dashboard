{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/admin-dashboard-andrejkatin/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/session-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
